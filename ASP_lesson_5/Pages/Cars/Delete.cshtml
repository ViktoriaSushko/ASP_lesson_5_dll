@page "{id?}"
@using CarLibrary.Models
@model ASP_lesson_5.Pages.Cars.DeleteModel
@{
}
<div class="container">
    <div class="row">
        <div class="col-3"></div>
        <div class="col">
            <h2>Do you want to delete car?</h2>
            @if(Model.Car is not null)
            {
                @if(Model.Car?.Image != null)
                {
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Car.Image)" width="200" height="150" style="object-fit:cover;" />
                }
                <dl>
                    <dt>@nameof(Car.Id)</dt>
                    <dd name="id">@Model?.Car?.Id</dd>
                    <dt>@nameof(Car.Manufacturer)</dt>
                    <dd name="manufacturer">@Model?.Car?.Manufacturer</dd>
                    <dt>@nameof(Car.Model)</dt>
                    <dd name="model">@Model?.Car?.Model</dd>
                    <dt>@nameof(Car.Year)</dt>
                    <dd name="year">@Model?.Car?.Year</dd>
                    <dt>@nameof(Car.Price)</dt>
                    <dd name="price">@Model?.Car?.Price</dd>
                </dl>
            }
           
            <form method="post">
                <input type="submit" class="btn btn-danger" value="delete"/>
            </form>
            <a href="/cars" class="btn btn-secondary">return to list</a>
        </div>
    </div>
</div>
